[Unit]
Description=claude-bridge-telegram broker (Claude Code <-> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h = the user's home. Assumes the repo is checked out at ~/claude-bridge-telegram
# and `uv sync` has created .venv there.
ExecStart=%h/claude-bridge-telegram/.venv/bin/bridge run
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
