[Unit]
Description=claude-bridge-telegram broker (Claude Code <-> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Paths below are filled in by deploy/install-service.sh from the repo's
# actual location, so the checkout can live anywhere (not just ~).
WorkingDirectory=@REPO_DIR@
ExecStart=@BRIDGE_BIN@ run
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
